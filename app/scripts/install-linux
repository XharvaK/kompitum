#!/bin/bash
# Points ~/.local/bin/kompitum-app at this checkout's release build and adds the
# launcher entry with the Kompitum icon. Re-run after moving the checkout.
set -euo pipefail

[[ $(uname -s) == Linux ]] || { echo 'This installer is for Linux.' >&2; exit 1; }
cd "$(dirname "$0")/.."
cargo build --release

data=${XDG_DATA_HOME:-$HOME/.local/share}
mkdir -p "$HOME/.local/bin" "$data/applications" "$data/icons/hicolor/scalable/apps"
ln -sfn "$PWD/target/release/kompitum-app" "$HOME/.local/bin/kompitum-app"
cp assets/icons/kompitum-icon.svg "$data/icons/hicolor/scalable/apps/kompitum-app.svg"
cat > "$data/applications/kompitum-app.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Kompitum
Comment=Terminals and coding agents that keep running
Exec=$HOME/.local/bin/kompitum-app
Icon=kompitum-app
Terminal=false
Categories=Development;
StartupWMClass=kompitum-app
EOF
update-desktop-database "$data/applications" 2>/dev/null || true
# A stale icon cache hides new icons until it's rebuilt.
[[ -f $data/icons/hicolor/icon-theme.cache ]] && gtk-update-icon-cache -f -t "$data/icons/hicolor" >/dev/null 2>&1 || true
echo "Installed kompitum-app. Quit and reopen Kompitum to use the new build."
