#!/bin/bash
# Points ~/.local/bin/limen-app at this checkout's release build and adds the
# launcher entry with the Limen icon. Re-run after moving the checkout.
set -euo pipefail

[[ $(uname -s) == Linux ]] || { echo 'This installer is for Linux.' >&2; exit 1; }
cd "$(dirname "$0")/.."
cargo build --release

data=${XDG_DATA_HOME:-$HOME/.local/share}
mkdir -p "$HOME/.local/bin" "$data/applications" "$data/icons/hicolor/scalable/apps"
ln -sfn "$PWD/target/release/limen-app" "$HOME/.local/bin/limen-app"
cp assets/icons/limen-ui-icon-clean.svg "$data/icons/hicolor/scalable/apps/limen-app.svg"
cat > "$data/applications/limen-app.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Limen
Comment=Terminals and coding agents that keep running
Exec=$HOME/.local/bin/limen-app
Icon=limen-app
Terminal=false
Categories=Development;
StartupWMClass=limen-app
EOF
update-desktop-database "$data/applications" 2>/dev/null || true
# A stale icon cache hides new icons until it's rebuilt.
[[ -f $data/icons/hicolor/icon-theme.cache ]] && gtk-update-icon-cache -f -t "$data/icons/hicolor" >/dev/null 2>&1 || true
echo "Installed limen-app. Quit and reopen Limen to use the new build."
