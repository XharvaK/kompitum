{
  "id": "root",
  "type": "row",
  "background": "canvas",
  "terminal_padding": [14, 12],
  "divider": { "width": 1, "color": "border" },
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "preview": "layouts/office.svg",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 248 },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        { "id": "brand", "type": "block", "size": { "px": 46 }, "window_drag": true, "content": { "mod": "workspace-chrome" } },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            { "id": "spaces", "type": "block", "size": { "weight": 1 }, "min": 90, "content": { "mod": "spaces" } },
            { "id": "line", "type": "block", "size": { "weight": 1 }, "min": 120, "content": { "mod": "line" } }
          ]
        },
        { "id": "sidebar-footer", "type": "block", "size": { "px": 28 }, "content": { "mod": "workspace-chrome", "props": { "footer": true } } }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        { "id": "tabs", "type": "block", "size": { "px": 42 }, "window_drag": true, "content": { "mod": "tabs" } },
        { "id": "office", "type": "block", "size": { "px": 250 }, "min": 170, "max": 520, "content": { "mod": "office" } },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": { "width": 1, "color": "border" },
                  "focus": { "width": 1, "color": "accent" },
                  "header": { "content": { "mod": "pane" }, "height": 30, "position": "top", "reveal": "always" }
                }
              }
            },
            {
              "id": "board",
              "type": "block",
              "size": { "px": 380 },
              "min": 280,
              "max": 720,
              "radius": 10,
              "border": { "width": 1, "color": "border" },
              "background": "surface",
              "content": { "mod": "board" }
            }
          ]
        },
        {
          "id": "status-row",
          "type": "row",
          "size": { "px": 28 },
          "resizable": false,
          "children": [
            { "id": "status", "type": "block", "content": { "mod": "workspace-status" } },
            { "id": "lead", "type": "block", "size": { "px": 232 }, "content": { "mod": "lead" } }
          ]
        }
      ]
    }
  ]
}
